<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.apache.maven.plugins.invoker</groupId>
  <artifactId>settings-active-profile-leak</artifactId>
  <version>1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <description>MINVOKER-293: a profile activated on the outer command line with -P must not be
  written into the settings.xml handed to the nested IT build, or a same-named profile declared
  by the IT project would activate unintentionally.</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <version.maven-enforcer-plugin>@version.maven-enforcer-plugin@</version.maven-enforcer-plugin>
  </properties>

  <!--
    Activated here via invoker.properties (invoker.profiles = leak-check), exactly like a real
    user running "mvn -Pleak-check ...". This profile is a no-op: it only needs to be active in
    the invoking process so its id ends up in this build's active profiles, the same as -P would.
  -->
  <profiles>
    <profile>
      <id>leak-check</id>
    </profile>
  </profiles>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-invoker-plugin</artifactId>
        <version>@project.version@</version>
        <configuration>
          <cloneProjectsTo>${project.build.directory}/it</cloneProjectsTo>
          <cloneClean>true</cloneClean>
        </configuration>
        <executions>
          <execution>
            <id>integration-test</id>
            <phase>initialize</phase>
            <goals>
              <goal>run</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
