// BeanShell cannot call methods on the Path itself (a JDK-internal class), so compare through Objects
import java.io.*;
import java.util.Objects;

if ( !Objects.equals( job.getBasedir(), basedir.toPath() ) )
{
    throw new Exception( "job.getBasedir() is " + job.getBasedir() + ", basedir is " + basedir );
}
if ( !Objects.equals( job.getBuildLog(), buildLog.toPath() ) )
{
    throw new Exception( "job.getBuildLog() is " + job.getBuildLog() + ", buildLog is " + buildLog );
}
if ( !Objects.equals( job.getLocalRepository(), localRepositoryPath.toPath() ) )
{
    throw new Exception( "job.getLocalRepository() is " + job.getLocalRepository() + ", localRepositoryPath is " + localRepositoryPath );
}
if ( !job.getMavenVersion().equals( mavenVersion ) )
{
    throw new Exception( "job.getMavenVersion() is " + job.getMavenVersion() + ", mavenVersion is " + mavenVersion );
}

new File( basedir, "job-checked.txt" ).createNewFile();

return true;
